rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTENTICAÇÃO E PERMISSÕES
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.get('role', '') in ['admin', 'owner'];
    }

    function isOwner() {
      return isAuthenticated()
        && request.auth.token.get('role', '') == 'owner';
    }

    function isOwnProfile(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    // ==========================================
    // VALIDAÇÃO DO PERFIL
    // ==========================================

    function isValidPlayerProfile() {
      return request.resource.data.keys().hasOnly([
          'playerId',
          'name',
          'role',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'playerId',
          'name',
          'role',
          'createdAt'
        ])
        && request.resource.data.playerId is string
        && request.resource.data.playerId.matches('^[0-9]{1,12}$')
        && request.resource.data.playerId != '194'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 32
        && request.resource.data.role == 'player'
        && request.resource.data.createdAt is string
        && request.auth.token.email ==
          request.resource.data.playerId
          + '@players.caca-bruxinhas.invalid';
    }

    // ==========================================
    // VALIDAÇÃO DOS PONTOS
    // ==========================================

    function isValidWitch() {
      return request.resource.data.keys().hasOnly([
          'number',
          'name',
          'region',
          'difficulty',
          'x',
          'y',
          'images',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'number',
          'name',
          'region',
          'difficulty',
          'x',
          'y',
          'images',
          'updatedAt'
        ])
        && request.resource.data.number is int
        && request.resource.data.number >= 1
        && request.resource.data.number <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.region in ['north', 'south']
        && request.resource.data.difficulty in [
          'easy',
          'medium',
          'hard'
        ]
        && request.resource.data.x is number
        && request.resource.data.x >= 0
        && request.resource.data.x <= 1
        && request.resource.data.y is number
        && request.resource.data.y >= 0
        && request.resource.data.y <= 1
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 2;
    }

    // ==========================================
    // VALIDAÇÃO DO PROGRESSO CONSOLIDADO
    // ==========================================

    function isValidProgress() {
      return request.resource.data.keys().hasOnly([
          'completedIds',
          'version'
        ])
        && request.resource.data.keys().hasAll([
          'completedIds',
          'version'
        ])
        && request.resource.data.version == 1
        && request.resource.data.completedIds is list
        && request.resource.data.completedIds.size() <= 100;
    }

    // ==========================================
    // USUÁRIOS
    // ==========================================

    match /users/{userId} {

      allow read: if isOwnProfile(userId) || isAdmin();

      allow create: if isOwnProfile(userId)
        && isValidPlayerProfile();

      allow update, delete: if false;

      // ========================================
      // NOVO SISTEMA DE PROGRESSO CONSOLIDADO
      // ========================================

      match /progress/{progressId} {

        allow read: if isOwnProfile(userId)
          && progressId == 'summary';

        allow create: if isOwnProfile(userId)
          && progressId == 'summary'
          && isValidProgress();

        allow update: if isOwnProfile(userId)
          && progressId == 'summary'
          && isValidProgress()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['completedIds']);

        allow delete: if false;
      }

      // ========================================
      // SISTEMA ANTIGO DE PROGRESSO
      // Mantido para preservar os registros
      // ========================================

      match /completedWitches/{witchId} {

        allow read: if isOwnProfile(userId);

        allow create: if isOwnProfile(userId)
          && exists(
            /databases/$(database)/documents/witches/$(witchId)
          )
          && request.resource.data.keys().hasOnly([
            'completedAt'
          ])
          && request.resource.data.keys().hasAll([
            'completedAt'
          ])
          && request.resource.data.completedAt is timestamp;

        allow delete: if isOwnProfile(userId);

        allow update: if false;
      }
    }

    // ==========================================
    // PONTOS DO MAPA
    // ==========================================

    match /witches/{witchId} {

      allow read: if isAuthenticated();

      allow create, update: if isAdmin()
        && isValidWitch();

      allow delete: if isAdmin();
    }
  }
}